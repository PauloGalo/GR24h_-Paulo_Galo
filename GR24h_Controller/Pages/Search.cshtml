@page
@model GR24h_Controller.Pages.SearchModel
@{
	ViewData["Title"] = "Pesquisa de Receitas";
}

<div class="container mt-4">
    <form method="get">
        <div class="row">
            <div class="col-md-3">
                <div class="card shadow p-3 mb-4 border-0">
                    <h5 class="mb-3 text-danger"><i class="bi bi-filter"></i> Filtros</h5>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nome da Receita</label>
                        <input type="text" asp-for="Filters.Name" class="form-control" placeholder="Ex: Lasanha...">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Autor / Chefe</label>
                        <input type="text" asp-for="Filters.Author" class="form-control" placeholder="Ex: Maria...">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold border-bottom w-100 pb-1">Categorias</label>
                        <div style="max-height: 200px; overflow-y: auto;">
                            @foreach (GR24h_Models.Category cat in Model.AvailableCategories)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Filters.Categories"
                                           value="@cat.Name" @(Model.Filters.Categories.Contains(cat.Name) ? "checked" : "")>
                                    <label class="form-check-label">@cat.Name</label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold border-bottom w-100 pb-1">Dificuldade</label>
                        @foreach (GR24h_Models.Difficulty diff in Model.AvailableDifficulties)
                        {
                            <div class="form-check">

                                <input class="form-check-input" type="checkbox" name="Filters.Difficulties"
                                       value="@diff.Name" @(Model.Filters.Difficulties.Contains(diff.Name) ? "checked" : "")>
                                <label class="form-check-label">@diff.Name</label>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold border-bottom w-100 pb-1">Ingredientes</label>
                        <div style="max-height: 150px; overflow-y: auto;">
                            @foreach (GR24h_Models.Ingredient ing in Model.AvailableIngredients)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Filters.Ingredients"
                                           value="@ing.Name" @(Model.Filters.Ingredients.Contains(ing.Name) ? "checked" : "")>
                                    <label class="form-check-label">@ing.Name</label>
                                </div>
                            }
                        </div>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 shadow-sm mb-2">
                        <i class="bi bi-search"></i> Filtrar
                    </button>
                    <a asp-page="/Search" class="btn btn-light w-100 text-muted">Limpar Filtros</a>
                </div>
            </div>

            <div class="col-md-9">

               
                <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-white rounded shadow-sm">
                    <span class="text-muted small ms-2">
                        A mostrar <strong>@Model.Recipes.Count</strong> receitas
                    </span>
                    <div class="d-flex align-items-center me-2">
                        <label class="me-2 text-nowrap fw-bold small mb-0">Ordenar por:</label>
                        <select asp-for="Filters.SortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="newest">Mais Recentes</option>
                            <option value="popular">Mais Populares</option>
                            <option value="rating_desc">Melhor Avaliadas</option>
                            <option value="title_asc">Nome (A-Z)</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    @if (Model.Recipes != null && Model.Recipes.Any())
                    {
                        foreach (GR24h_Models.RecipeDetailsDTO recipeDto in Model.Recipes)
                        {
                            bool isFav = Model.UserFavouriteRecipeIds.Contains(recipeDto.Recipe.Id);

                            <div class="col-md-4 mb-4">
                                <div class="card h-100 border-0 shadow-sm hover-lift rounded-4 overflow-hidden">

                                   
                                    <div class="position-relative">

                                        
                                        <div class="position-absolute top-0 start-0 m-2 z-1">
                                            <span class="badge bg-success shadow-sm">Publicada</span>
                                        </div>

                                        
                                        <div class="position-absolute bottom-0 start-0 m-2 z-1">
                                            <span class="badge bg-dark bg-opacity-75 text-white fw-bold px-2 py-1 shadow-sm">
                                                <i class="bi bi-fire text-danger me-1"></i>Score: @recipeDto.PopularityScore.ToString("F1")
                                            </span>
                                        </div>

                                        <div class="position-absolute top-0 end-0 m-2 z-2">
                                            <form method="post" asp-page-handler="ToggleFavourite" asp-route-recipeId="@recipeDto.Recipe.Id">
                                                <button type="submit"
                                                        class="btn btn-light shadow-sm rounded-circle d-flex align-items-center justify-content-center p-0 border-0"
                                                        style="width: 36px; height: 36px; transition: transform 0.2s;"
                                                        title="@(isFav ? "Remover dos favoritos" : "Adicionar aos favoritos")">
                                                    @if (isFav)
                                                    {
                                                        <i class="bi bi-heart-fill text-danger fs-6"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-heart text-dark fs-6"></i>
                                                    }
                                                </button>
                                            </form>
                                        </div>

                                      
                                        <div class="position-absolute bottom-0 end-0 m-2 z-1">
                                            <span class="badge bg-dark bg-opacity-75 text-warning fw-bold px-2 py-1 shadow-sm">
                                                <i class="bi bi-star-fill me-1"></i>
                                                @(recipeDto.Recipe.Rating.HasValue? recipeDto.Recipe.Rating.Value.ToString("F1") : "N/A")
                                            </span>
                                        </div>

                                        <a asp-page="/RecipePage" asp-route-id="@recipeDto.Recipe.Id">
                                            <img src="@recipeDto.Recipe.GetFormattedImageUrl()"
                                                 class="card-img-top"
                                                 alt="@recipeDto.Recipe.Title"
                                                 style="height: 220px; object-fit: cover;"
                                                 onerror="this.src='/images/default-recipe.jpg'">
                                        </a>
                                    </div>

                                    <div class="card-body">
                                        
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h5 class="card-title mb-0 fw-bold text-truncate me-2" title="@recipeDto.Recipe.Title">
                                                <a asp-page="/RecipePage" asp-route-id="@recipeDto.Recipe.Id" class="text-decoration-none text-dark">
                                                    @recipeDto.Recipe.Title
                                                </a>
                                            </h5>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                                                @recipeDto.CategoryName
                                            </span>
                                        </div>

                                        
                                        <div class="d-flex justify-content-between align-items-center text-muted small mt-3">
                                            <span class="text-truncate me-1" title="@recipeDto.AuthorUsername">
                                                <i class="bi bi-person-circle me-1"></i>@recipeDto.AuthorUsername
                                            </span>
                                            <span class="text-nowrap mx-1">
                                                <i class="bi bi-clock me-1"></i>@recipeDto.Recipe.PreparationTime 
                                            </span>
                                            <span class="text-nowrap ms-1">
                                                <i class="bi bi-bar-chart me-1"></i>@recipeDto.DifficultyName
                                            </span>
                                        </div>
                                    </div>

                                   
                                    <div class="card-footer bg-white border-0 pb-3">
                                        <div class="d-grid">
                                            <a asp-page="/RecipePage" asp-route-id="@recipeDto.Recipe.Id" class="btn btn-primary rounded-pill btn-sm">
                                                Ver Detalhes
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center py-5 bg-white rounded shadow-sm">
                            <i class="bi bi-search-heart display-1 text-muted"></i>
                            <p class="mt-3 fs-5 text-secondary">Ups! Não encontrámos receitas para estes filtros.</p>
                        </div>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-5">
                        <ul class="pagination justify-content-center">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {

                                Dictionary<string, string> routeParams = new Dictionary<string, string>();
                                routeParams.Add("p", i.ToString());

                                if (!string.IsNullOrEmpty(Model.Filters.Name))
                                    routeParams.Add("Filters.Name", Model.Filters.Name);

                                if (!string.IsNullOrEmpty(Model.Filters.Author))
                                    routeParams.Add("Filters.AuthorName", Model.Filters.Author);

                                if (!string.IsNullOrEmpty(Model.Filters.SortBy))
                                    routeParams.Add("Filters.SortBy", Model.Filters.SortBy);

                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link shadow-sm @(i == Model.CurrentPage ? "bg-danger border-danger text-white" : "text-dark")"
                                       asp-page="/Search"
                                       asp-all-route-data="routeParams">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </form>
</div>

<style>
    .hover-lift {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .hover-lift:hover {
            transform: translateY(-8px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
        }

    .bg-primary-subtle {
        background-color: #e7f1ff;
    }
</style>
