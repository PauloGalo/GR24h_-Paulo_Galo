@page
@model GR24h_Controller.Pages.PersonalAreaManagement.UserPersonalManagement.UserMyRecipesModel
@{

    ViewData["Title"] = "As Minhas Receitas Publicadas";
}

<div class="container mt-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-7">
            <h2 class="fw-bold text-primary mb-0">As Minhas Receitas Publicadas 📖</h2>
            <p class="text-muted">Gerencia as tuas receitas que já estão online.</p>
        </div>
        <div class="col-md-5 text-md-end">
            <a asp-page="/PersonalAreaManagement/UserPersonalManagement/UserProfile" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-house-door"></i> Dashboard
            </a>
            <div class="mt-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle me-2">
                    <i class="bi bi-check-circle"></i> @Model.TotalApproved Aprovadas
                </span>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                    <i class="bi bi-hourglass-split"></i> @Model.TotalPending Pendentes
                </span>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-5">
        <a asp-page="/PersonalAreaManagement/UserPersonalManagement/UserCreateRecipe" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Criar Receita
        </a>
        <a asp-page="/PersonalAreaManagement/UserPersonalManagement/UserRecipesPending" class="btn btn-light border shadow-sm">
            <i class="bi bi-hourglass-split me-1"></i> Ver Pendentes
        </a>
        <a asp-page="/PersonalAreaManagement/UserPersonalManagement/UserFavourites" class="btn btn-light border shadow-sm">
            <i class="bi bi-heart me-1"></i> Favoritos
        </a>
        <a asp-page="/PersonalAreaManagement/UserPersonalManagement/UserRecipesSuggestions" class="btn btn-light border shadow-sm">
            <i class="bi bi-lightbulb me-1"></i> Sugestões
        </a>
    </div>

    @if (!Model.MyActiveRecipes.Any())
    {
        <div class="alert alert-light text-center border shadow-sm p-5 rounded-4">
            <i class="bi bi-journal-x display-1 text-secondary"></i>
            <h4 class="mt-3 text-secondary">Ainda não tens receitas públicas.</h4>
            <p class="text-muted">Cria uma nova ou aguarda a aprovação das tuas receitas pendentes.</p>
            <a asp-page="/PersonalAreaManagement/UserPersonalManagement/UserCreateRecipe" class="btn btn-primary px-4 rounded-pill mt-2">
                Começar a Cozinhar
            </a>
        </div>
    }
    else
    {

        <div class="row">
            @foreach (GR24h_Models.RecipeDetailsDTO recipeDto in Model.MyActiveRecipes)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm hover-lift rounded-4 overflow-hidden">

                        <div class="position-relative">
                           
                            <div class="position-absolute top-0 start-0 m-2 z-1">
                                <span class="badge bg-success shadow-sm">Publicada</span>
                            </div>

                           
                            <div class="position-absolute bottom-0 start-0 m-2 z-1">
                                <span class="badge bg-dark bg-opacity-75 text-white fw-bold px-2 py-1 shadow-sm" title="Score de Popularidade">
                                    <i class="bi bi-fire text-danger me-1"></i>Score: @recipeDto.PopularityScore.ToString("F0")
                                </span>
                            </div>

                           
                            <div class="position-absolute bottom-0 end-0 m-2 z-1">
                                <span class="badge bg-dark bg-opacity-75 text-warning fw-bold px-2 py-1 shadow-sm">
                                    <i class="bi bi-star-fill me-1"></i>
                                    @(recipeDto.Recipe.Rating.HasValue? recipeDto.Recipe.Rating.Value.ToString("F1") : "N/A")
                                </span>
                            </div>

                            
                            <a asp-page="/RecipePage" asp-route-id="@recipeDto.Recipe.Id">
                                <img src="@recipeDto.Recipe.GetFormattedImageUrl()"
                                     class="card-img-top"
                                     alt="@recipeDto.Recipe.Title"
                                     style="height: 220px; object-fit:cover;"
                                     onerror="this.src='/images/default-recipe.jpg'">
                            </a>
                        </div>

                        <div class="card-body">
                            
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title mb-0 fw-bold text-truncate me-2" title="@recipeDto.Recipe.Title">
                                    <a asp-page="/RecipePage" asp-route-id="@recipeDto.Recipe.Id" class="text-decoration-none text-dark">
                                        @recipeDto.Recipe.Title
                                    </a>
                                </h5>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                                    @recipeDto.CategoryName
                                </span>
                            </div>

                            
                            <div class="d-flex justify-content-between align-items-center text-muted small mt-3">
                                <span class="text-truncate me-1" title="@recipeDto.AuthorUsername">
                                    <i class="bi bi-person-circle me-1"></i>@recipeDto.AuthorUsername
                                </span>
                                <span class="text-nowrap mx-1">
                                    <i class="bi bi-clock me-1"></i>@recipeDto.Recipe.PreparationTime 
                                </span>
                                <span class="text-nowrap ms-1">
                                    <i class="bi bi-bar-chart me-1"></i>@recipeDto.DifficultyName
                                </span>
                            </div>
                        </div>

                      
                        <div class="card-footer bg-white border-0 d-flex gap-2 pb-3">
                            <a asp-page="/RecipePage" asp-route-id="@recipeDto.Recipe.Id" class="btn btn-primary btn-sm flex-grow-1 rounded-pill">
                                Ver Receita
                            </a>
                            <a asp-page="/EditRecipePage" asp-route-id="@recipeDto.Recipe.Id" class="btn btn-outline-secondary btn-sm rounded-pill" title="Editar Receita">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Navegação de páginas" class="mt-4 mb-5">
                <ul class="pagination justify-content-center">

                   
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3 me-1" asp-page="./UserMyRecipes" asp-route-p="@(Model.CurrentPage - 1)">
                            <i class="bi bi-chevron-left me-1"></i> Anterior
                        </a>
                    </li>

                   
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link rounded-circle mx-1 text-center" style="width: 40px; height: 40px; line-height: 24px;" asp-page="./UserMyRecipes" asp-route-p="@i">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3 ms-1" asp-page="./UserMyRecipes" asp-route-p="@(Model.CurrentPage + 1)">
                            Seguinte <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </li>

                </ul>
            </nav>
        }
    }
</div>

<style>
    .hover-lift {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .hover-lift:hover {
            transform: translateY(-8px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
        }

    .btn-light.border {
        background-color: #ffffff;
        color: #495057;
        font-weight: 500;
        transition: all 0.2s;
    }

        .btn-light.border:hover {
            background-color: #f8f9fa;
            border-color: #0d6efd !important;
            color: #0d6efd;
        }

    .bg-success-subtle {
        background-color: #d1e7dd;
    }

    .bg-warning-subtle {
        background-color: #fff3cd;
    }
</style>
       