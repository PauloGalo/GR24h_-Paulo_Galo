<!DOCTYPE html>
<html lang="pt-pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GaloReceitas24horas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid d-flex justify-content-between align-items-center px-4">

                <div class="d-flex align-items-center">
                    <button class="btn me-2 text-danger border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu">
                        <i class="bi bi-list" style="font-size: 1.8rem;"></i>
                    </button>
                    <a class="navbar-brand fw-bold d-flex align-items-center m-0 p-0" asp-page="/Index">
                        <img src="/images/logo_galo.jpg" alt="Galo" width="55" height="55" class="me-1" style="object-fit: contain;">
                        <span style="font-size: 1.5rem; letter-spacing: -1px; margin-top: 5px;">
                            <span class="text-dark">Receitas</span><span class="text-danger">24horas</span>
                        </span>
                    </a>
                </div>

                <div class="flex-grow-1 mx-4 d-none d-md-block" style="max-width: 500px;">
                    <form id="searchForm" asp-page="/Search" method="get">
                        <div class="input-group shadow-sm">
                            <input id="searchInput"
                                   name="Filters.SearchTerm"
                                   value="@Context.Request.Query["Filters.SearchTerm"]"
                                   class="form-control border-danger border-2"
                                   type="search"
                                   placeholder="O que vamos cozinhar hoje?">
                            <button class="btn btn-danger px-3" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const searchInput = document.getElementById('searchInput');
                        const searchForm = document.getElementById('searchForm');
                        let typingTimer;

                        if (searchInput && searchForm) {
                            searchInput.addEventListener('input', function () {
                                clearTimeout(typingTimer);
                                
                                typingTimer = setTimeout(function () {
                                    searchForm.submit();
                                }, 400);
                            });
                        }
                    });
                </script>

                <div class="d-flex align-items-center">
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <div class="dropdown">
                            <a class="nav-link text-dark fw-bold px-2 d-flex align-items-center dropdown-toggle"
                               href="#" role="button" id="personalMenu" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.9rem;">
                                <i class="bi bi-person-circle me-2 text-danger" style="font-size: 1.4rem;"></i>

                                <span>@Context.Session.GetString("UserName")</span>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="personalMenu" style="min-width: 250px;">
                                @if (Context.Session.GetString("UserRole") == "Admin")
                                {
                                    <li class="nav-item text-muted ps-4 small my-3 text-uppercase fw-bold" style="letter-spacing: 2px;">Gestão Admin</li>

                                    <li class="nav-item">
                                        <a class="nav-link text-dark py-2 px-4"
                                           asp-page="/PersonalAreaManagement/AdminPersonalManagement/AdminProfile"
                                           asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-speedometer2 me-3 text-danger"></i>Dashboard
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link text-dark py-2 px-4"
                                           asp-page="/PersonalAreaManagement/PersonalData"
                                           asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-person-badge me-3 text-danger"></i>Meus Dados Pessoais
                                        </a>
                                    </li>

                                    <li class="nav-item text-muted ps-4 small my-3 text-uppercase fw-bold">Gestão de Receitas</li>

                                    <li class="nav-item">
                                        <a class="nav-link text-dark py-2 px-4"
                                           asp-page="/PersonalAreaManagement/AdminPersonalManagement/AdminCategoriesManagement"
                                           asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-tags me-3"></i> Gestão de Categorias
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link text-dark py-2 px-4"
                                           asp-page="/PersonalAreaManagement/AdminPersonalManagement/AdminDifficultiesManagement"
                                           asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-bar-chart me-3"></i>Gestão de Dificuldades
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link text-dark py-2 px-4"
                                           asp-page="/PersonalAreaManagement/AdminPersonalManagement/AdminIngredientsManagement"
                                           asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-basket me-3"></i>Gestão de Ingredientes
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link text-dark py-2 px-4 font-weight-bold text-danger"
                                           asp-page="/PersonalAreaManagement/AdminPersonalManagement/AdminPendingRecipes"
                                           asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-clock-history me-3"></i>Receitas Pendentes
                                        </a>
                                    </li>

                                    <li class="nav-item text-muted ps-4 small my-3 text-uppercase fw-bold">Gestão de Users</li>

                                    <li class="nav-item border-bottom mb-2">
                                        <a class="nav-link text-dark py-2 px-4"
                                           asp-page="/PersonalAreaManagement/AdminPersonalManagement/AdminUserManagement"
                                           asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-people me-3"></i>Gestão de Users
                                        </a>
                                    </li>


                                }
                                else if (Context.Session.GetString("UserRole") == "User")
                                {
                                    <li class="nav-item text-muted ps-4 small my-3 text-uppercase fw-bold" style="letter-spacing: 2px;">Minha Área Pessoal</li>

                                    <li class="nav-item">
                                        <a class="nav-link text-dark py-2 px-4" asp-page="/PersonalAreaManagement/UserPersonalManagement/UserProfile" asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-person-circle me-3 text-primary"></i>Dashboard
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark py-2 px-4" asp-page="/PersonalAreaManagement/PersonalData" asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-person-gear me-3 text-primary"></i>Meus Dados Pessoais
                                        </a>
                                    </li>

                                    <li class="nav-item text-muted ps-4 small my-3 text-uppercase fw-bold">Minhas Receitas</li>

                                    <li class="nav-item">
                                        <a class="nav-link text-dark py-2 px-4" asp-page="/PersonalAreaManagement/UserPersonalManagement/UserCreateRecipe" asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-plus-circle me-3 text-success"></i>Criar Receita
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark py-2 px-4" asp-page="/PersonalAreaManagement/UserPersonalManagement/UserMyRecipes" asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-journal-text me-3"></i>Receitas Criadas
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark py-2 px-4" asp-page="/PersonalAreaManagement/UserPersonalManagement/UserRecipesPending" asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-hourglass-split me-3 text-warning"></i>Receitas Pendentes
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark py-2 px-4" asp-page="/PersonalAreaManagement/UserPersonalManagement/UserFavourites" asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-heart-fill me-3 text-danger"></i>Minhas Favoritas
                                        </a>
                                    </li>
                                    <li class="nav-item border-bottom mb-2">
                                        <a class="nav-link text-dark py-2 px-4" asp-page="/PersonalAreaManagement/UserPersonalManagement/UserRecipesSuggestions" asp-route-id="@Context.Session.GetInt32("UserId")">
                                            <i class="bi bi-lightbulb me-3 text-info"></i> Receitas Sugeridas
                                        </a>
                                    </li>
                                }

                                else
                                {
                                    <li class="nav-item text-muted ps-4 small my-3 text-uppercase fw-bold" style="letter-spacing: 2px;">Bem-vindo!</li>

                                    <li class="nav-item border-bottom">
                                        <a class="nav-link text-dark py-3 px-4 fw-bold" asp-page="/LoginRegister">
                                            <i class="bi bi-box-arrow-in-right me-3 text-danger"></i>Entrar ou Registar
                                        </a>
                                    </li>

                                    <li class="nav-item text-muted ps-4 small my-3 text-uppercase fw-bold">Destaques</li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark py-2 px-4" asp-page="/Recipes/Index">
                                            <i class="bi bi-star-fill me-3 text-warning"></i>Melhores Receitas
                                        </a>
                                    </li>
                                }

                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger fw-bold" asp-page="/PersonalAreaManagement/Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Terminar Sessão
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {

                        <a class="nav-link text-dark fw-bold px-2 d-flex align-items-center" asp-page="/LoginRegister" style="font-size: 0.9rem;">
                            <i class="bi bi-person me-2" style="font-size: 1.2rem;"></i>
                            <span>Login</span>
                        </a>
                        <span class="text-muted">|</span>
                        <a class="nav-link text-dark fw-bold px-2" asp-page="/LoginRegister" style="font-size: 0.9rem;">
                            <span>Registar</span>
                        </a>

                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarMenu">
        <div class="offcanvas-header border-bottom bg-danger text-white">
            <h5 class="offcanvas-title fw-bold">GaloReceitas24horas</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-0">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link text-dark fw-bold py-3 px-4 border-bottom" asp-page="/Index">
                        <i class="bi bi-house-door-fill me-3 text-danger"></i>Início
                    </a>
                </li>
                <li class="nav-item border-bottom">
                    <a class="nav-link text-dark fw-bold py-3 px-4" asp-page="/Search">
                        <i class="bi bi-book-half me-3 text-primary"></i>Todas as Receitas
                    </a>
                </li>

                <li class="nav-item text-muted ps-4 small my-3 text-uppercase fw-bold" style="letter-spacing: 2px;">Categorias</li>
                <li class="nav-item"><a class="nav-link text-dark py-2 px-4" asp-page="/Search" asp-route-Filters.Categories="Carnes"><i class="fa-solid fa-drumstick-bite me-3 text-danger"></i>Carnes</a></li>
                <li class="nav-item"><a class="nav-link text-dark py-2 px-4" asp-page="/Search" asp-route-Filters.Categories="Peixes"><i class="fa-solid fa-fish me-3 text-primary"></i>Peixes</a></li>
                <li class="nav-item"><a class="nav-link text-dark py-2 px-4" asp-page="/Search" asp-route-Filters.Categories="Sopas"><i class="fa-solid fa-bowl-rice me-3 text-warning"></i>Sopas</a></li>
                <li class="nav-item"><a class="nav-link text-dark py-2 px-4" asp-page="/Search" asp-route-Filters.Categories="Sanduíches"><i class="fa-solid fa-bread-slice me-3 text-warning"></i>Sanduíches</a></li>
                <li class="nav-item"><a class="nav-link text-dark py-2 px-4" asp-page="/Search" asp-route-Filters.Categories="Pizzas"><i class="fa-solid fa-pizza-slice me-3 text-danger"></i>Pizzas</a></li>
                <li class="nav-item"><a class="nav-link text-dark py-2 px-4" asp-page="/Search" asp-route-Filters.Categories="Saladas"><i class="fa-solid fa-leaf me-3 text-success"></i>Saladas</a></li>
                <li class="nav-item"><a class="nav-link text-dark py-2 px-4" asp-page="/Search" asp-route-Filters.Categories="Vegetariano"><i class="fa-solid fa-seedling me-3 text-success"></i>Vegetariano</a></li>
                <li class="nav-item"><a class="nav-link text-dark py-2 px-4 mb-3" asp-page="/Search" asp-route-Filters.Categories="Sobremesas"><i class="fa-solid fa-cookie-bite me-3 text-info"></i>Sobremesas</a></li>

                <li class="px-4 py-1">
                    <hr class="dropdown-divider m-0" />
                </li>

                <li class="nav-item text-muted ps-4 small mb-2 text-uppercase fw-bold">Dificuldade</li>
                <li class="nav-item"><a class="nav-link text-dark py-1 px-4" asp-page="/Search" asp-route-Filters.Difficulties="Fácil"><i class="bi bi-star text-success me-3"></i>Fácil</a></li>
                <li class="nav-item"><a class="nav-link text-dark py-1 px-4" asp-page="/Search" asp-route-Filters.Difficulties="Médio"><i class="bi bi-star-half text-warning me-3"></i>Médio</a></li>
                <li class="nav-item"><a class="nav-link text-dark py-1 px-4" asp-page="/Search" asp-route-Filters.Difficulties="Difícil"><i class="bi bi-star-fill text-danger me-3"></i>Difícil</a></li>
            </ul>
        </div>
    </div>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-4 bg-light">
        <div class="container text-center">
            <p class="mb-1 text-dark"><strong>GaloReceitas24horas</strong> &copy; 2026</p>
            <p class="small mb-1">A cozinhar com alma lusitana. 🇵🇹</p>
            <div class="mt-2 d-flex justify-content-center align-items-center gap-3">
                <a asp-page="/Privacy" class="text-secondary text-decoration-none small">
                    <i class="bi bi-shield-lock-fill me-1"></i>Política de Privacidade & Cookies
                </a>
                <span class="text-muted">•</span>
                <span class="text-secondary small">
                    <i class="bi bi-envelope-fill me-1"></i>suporte@galoreceitas24horas.pt
                </span>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div id="loadingOverlay" class="d-none position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-75 d-flex flex-column align-items-center justify-content-center" style="z-index: 9999;">
        <div class="spinner-border text-warning mb-3" style="width: 3.5rem; height: 3.5rem;" role="status">
            <span class="visually-hidden">A carregar...</span>
        </div>
        <h4 class="text-white fw-bold">A preparar a cozinha...</h4>
        <p class="text-white-50">Isto está a demorar um bocadinho mais do que o normal, mas o Galo já está a tratar disso!</p>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let loadingTimer = null;
            const overlay = document.getElementById('loadingOverlay');

            document.addEventListener('submit', function (e) {
                const form = e.target;

                if (form.checkValidity()) {
                    if (loadingTimer) clearTimeout(loadingTimer);

                    loadingTimer = setTimeout(function () {
                        if (overlay) overlay.style.setProperty('display', 'flex', 'important');
                    }, 800);
                }
            });
        });
    </script>
</body>
</html>

